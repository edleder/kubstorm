{
  "name": "kubstorm",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && sleep 2 && NODE_ENV=development electron .\"",
    "electron-build": "npm run build && electron-builder",
    "electron-pack": "npm run build && electron-builder --dir",
    "electron": "electron ."
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google-cloud/monitoring": "^5.3.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/js-yaml": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "build": {
    "appId": "com.kubstorm.app",
    "productName": "Kubstorm",
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kubstorm"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/favicon.ico",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/favicon.ico",
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "next-auth": "^4.24.14",
    "prisma": "^7.8.0",
    "recharts": "^3.8.1",
    "shadcn-ui": "^0.9.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.5",
    "zustand": "^5.0.12"
  }
}
