{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile"
  },
  "deploy": {
    "startCommand": "node_modules/.bin/next start",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 5
  },
  "httpServer": {
    "httpPort": 3000,
    "basePath": "/"
  }
}
