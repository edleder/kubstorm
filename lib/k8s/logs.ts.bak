import { execSync } from 'child_process';
import * as fs from 'fs';
import * as path from 'path';
import * as os from 'os';

export async function getPodLogs(
  kubeconfigString: string,
  namespace: string,
  podName: string,
  container?: string
): Promise<string> {
  try {
    // Write kubeconfig to temp file
    const tmpDir = os.tmpdir();
    const tmpFile = path.join(tmpDir, `kubeconfig-${Date.now()}-${Math.random().toString(36).substring(7)}`);
    fs.writeFileSync(tmpFile, kubeconfigString, 'utf8');

    try {
      const containerFlag = container ? `-c ${container}` : '';
      const output = execSync(
        `kubectl logs ${podName} -n ${namespace} ${containerFlag} --tail=1000`,
        {
          env: { ...process.env, KUBECONFIG: tmpFile },
          encoding: 'utf-8',
          stdio: ['pipe', 'pipe', 'pipe'],
          maxBuffer: 10 * 1024 * 1024,
        }
      );

      return output;
    } finally {
      fs.unlinkSync(tmpFile);
    }
  } catch (error) {
    const errorMessage = error instanceof Error ? error.message : 'Unknown error';

    if (errorMessage.includes('not found')) {
      throw new Error(`Pod "${podName}" not found in namespace "${namespace}"`);
    }

    throw new Error(
      `Failed to get pod logs: ${errorMessage}`
    );
  }
}

export async function getPodLogsStream(
  kubeconfigString: string,
  namespace: string,
  podName: string,
  container?: string
): Promise<string> {
  return getPodLogs(kubeconfigString, namespace, podName, container);
}
